# Backend: "firebase" | "local" (default)
VITE_BACKEND=local

# Firebase (required when VITE_BACKEND=firebase)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_APP_ID=

# Slip storage: "storage" (requires Blaze) | "firestore" (Spark, default)
VITE_SLIP_MODE=firestore
